# Copy to .env (git-ignored) and adjust. Values below match docker-compose.yml at the repo root.
DATABASE_URL=mysql://pd:pd_dev@127.0.0.1:3307/pd
# Scratch database for `prisma migrate dev` (needs a user that may create databases)
SHADOW_DATABASE_URL=mysql://root:pd_root_dev@127.0.0.1:3307/pd_shadow
# Separate database for automated tests (migrations applied by the test setup; test data is never wiped automatically)
TEST_DATABASE_URL=mysql://root:pd_root_dev@127.0.0.1:3307/pd_test
# At least 32 random characters (the example value below is refused on purpose), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3100
# Listen address. Default 127.0.0.1 (this computer only). To let a phone on the same Wi-Fi reach it
# (mini-program testing), start once with `set HOST=0.0.0.0` in the shell, then restart without it.
# HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API (web dev server, admin dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Where uploaded files (source images, thumbnails) are stored
STORAGE_DIR=./storage
# WeChat mini-program login (optional; /auth/wx-login answers 503 when unset)
WX_APPID=
WX_SECRET=
