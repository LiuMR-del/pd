{
  "name": "@pd/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Backend (stage 2): accounts, cloud works with history, palettes, files. NestJS + Prisma + MySQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "prisma generate && tsx scripts/build.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "admin:create": "tsx scripts/admin-create.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@pd/editor-core": "workspace:*",
    "@pd/palettes": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
