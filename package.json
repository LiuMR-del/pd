{
  "name": "pd",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @pd/palettes build:data && pnpm --filter @pd/server db:generate",
    "palettes:sync": "pnpm --filter @pd/palettes fetch:mard && pnpm --filter @pd/palettes build:data",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @pd/bench bench",
    "dev:web": "pnpm --filter @pd/web dev",
    "dev:web:lan": "pnpm --filter @pd/web dev --host",
    "build:web": "pnpm --filter @pd/web build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev:server": "pnpm --filter @pd/server dev",
    "build:server": "pnpm --filter @pd/server build",
    "dev:admin": "pnpm --filter @pd/admin dev",
    "build:admin": "pnpm --filter @pd/admin build",
    "dev:miniapp": "pnpm --filter @pd/miniapp dev",
    "build:miniapp": "pnpm --filter @pd/miniapp build"
  }
}
